027A C2A9       312            clr ET0
027C            313   
027C            314            ;initialize time values
027C 753200     315            mov BCD_counter, #0x00
027F 753300     316            mov MIN_counter, #0x00
0282 753411     317            mov HOUR_counter, #0x11
0285 753600     318            mov Alarm_min_counter, #0x00
0288 753512     319            mov Alarm_hour_counter, #0x12
028B            320   
028B            321            ; After initialization the program stays in this 'forever' loop
028B            322   loop:
028B            323            ;check if alarm button pressed
028B 209050     324            jb TOGGLE_ALARM_BUTTON, hour_add  ; if the 'CLEAR' button is not pressed skip
028E C002       325            push AR2
0290 7A32       325            mov R2, #50
0292 120038     325            lcall ?Wait_Milli_Seconds
0295 D002       325            pop AR2         ; Debounce delay.  This macro is also in 'LCD_4bit.inc'
0297 209044     326            jb TOGGLE_ALARM_BUTTON, hour_add  ; if the 'CLEAR' button is not pressed skip
029A 3090FD     327            jnb TOGGLE_ALARM_BUTTON, $              ; Wait for button release.  The '$' means: jump to same instruction.
029D            328            ; Alarm toggle pressed
029D            329            ; Check if alarm is on or off already
029D 200220     330            jb alarm_on_flag, alarm_on
02A0            331            ;alarm is of, turn on
02A0 C0E0       332            push acc
02A2 740F       332            mov a, #15
02A4 14         332            dec a
02A5 1200C5     332            lcall ?Set_Cursor_2 ; Select column and row
02A8 D0E0       332            pop acc
02AA C083       333            push dph
02AC C082       333            push dpl
02AE C0E0       333            push acc
02B0 900104     333            mov dptr, #Alarm_On_Message
02B3 1200BA     333            lcall ?Send_Constant_String
02B6 D0E0       333            pop acc
02B8 D082       333            pop dpl
02BA D083       333            pop dph
02BC D202       334            setb alarm_on_flag ; set alarm flag to on
02BE 801E       335            sjmp hour_add ; move on to adding hour
02C0            336   alarm_on:
02C0 C0E0       337            push acc
02C2 740F       337            mov a, #15
02C4 14         337            dec a
02C5 1200C5     337            lcall ?Set_Cursor_2 ; Select column and row
02C8 D0E0       337            pop acc
02CA C083       338            push dph
02CC C082       338            push dpl
02CE C0E0       338            push acc
02D0 900107     338            mov dptr, #Alarm_Off_Message
02D3 1200BA     338            lcall ?Send_Constant_String
02D6 D0E0       338            pop acc
02D8 D082       338            pop dpl
02DA D083       338            pop dph
02DC C202       339            clr alarm_on_flag
02DE            340   
02DE            341   hour_add:
02DE 20B05C     342            jb HOUR_UP_BUTTON, minute_add  ; if the 'CLEAR' button is not pressed skip
02E1 C002       343            push AR2
02E3 7A32       343            mov R2, #50
02E5 120038     343            lcall ?Wait_Milli_Seconds
02E8 D002       343            pop AR2
02EA            343            ; Debounce delay.  This macro is also in 'LCD_4bit.inc'
02EA 20B050     344            jb HOUR_UP_BUTTON, minute_add  ; if the 'CLEAR' button is not pressed skip
02ED 30B0FD     345            jnb HOUR_UP_BUTTON, $           ; Wait for button release.  The '$' means: jump to same instruction.
02F0            346            
02F0            347            ; BUTTON PRESSED
02F0 E534       348            mov a, HOUR_counter
02F2 2401       349            add a, #0x01
02F4 D4         350            da a
02F5 B41343     351            cjne a, #0x13, continue_h_add
02F8 7401       352            mov a, #0x01
02FA            353            ; change am pm
02FA 200120     354            jb is_am, switch_to_pm
02FD            355            ; is pm
